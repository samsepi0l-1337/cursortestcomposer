# Setup: copy to .env, fill values, then run:
#   npx prisma migrate dev
#   npx tsx prisma/seed.ts  (optional: creates admin@example.com / admin123)

# Database (SQLite for local dev)
DATABASE_URL="file:./dev.db"

# Auth.js - generate with: npx auth secret
AUTH_SECRET=

# OAuth (optional - omit for credentials-only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# UploadThing - from https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=
